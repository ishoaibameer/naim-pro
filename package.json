{
  "name": "naim-pro",
  "description": "Mobile-first wood trading, logistics, payment, document, and audit management system.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db:setup": "tsx scripts/test-database.ts setup",
    "test:db:reset": "tsx scripts/test-database.ts reset",
    "test:db:teardown": "tsx scripts/test-database.ts teardown",
    "test:e2e": "playwright test",
    "test:e2e:fixtures": "tsx scripts/e2e-fixtures.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:preflight": "tsx scripts/migration-preflight.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-auth.ts",
    "auth:bootstrap:production": "tsx scripts/bootstrap-production-admin.ts",
    "security:secrets": "tsx scripts/secret-safety-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.46",
    "argon2": "0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "10.0.1",
    "jsdom": "^28",
    "nitro": "npm:nitro-nightly@3.0.1-20260810-113911-16ff2809",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "4.23.12",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
