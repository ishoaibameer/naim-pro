# Environment identity: development, staging, or production.
APP_ENV=development
APP_ORIGIN=http://localhost:3000

# Use a separate encrypted PostgreSQL database for every environment.
DATABASE_URL=postgresql://naim_pro:change-me@localhost:5432/naim_pro
DATABASE_MAX_CONNECTIONS=5

# Generate independently per environment. Never reuse this placeholder.
SESSION_SECRET=replace-with-a-random-secret-at-least-48-characters-long

LOG_LEVEL=info
SLOW_QUERY_THRESHOLD_MS=1000

# NONE is safest unless the named reverse proxy is configured to strip inbound forwarding headers.
TRUSTED_PROXY_MODE=NONE

# Development may use local private storage. Production should use s3.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=.data/documents
# DOCUMENT_STORAGE_BUCKET=replace-with-private-bucket-name
# DOCUMENT_STORAGE_ENDPOINT=https://replace-with-s3-compatible-endpoint
# DOCUMENT_STORAGE_REGION=replace-with-region
# DOCUMENT_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
# DOCUMENT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
DOCUMENT_STORAGE_FORCE_PATH_STYLE=false
ALLOW_UNSAFE_LOCAL_DOCUMENT_STORAGE=false

# No scanner is bundled. REQUIRED fails uploads until a real adapter is configured.
DOCUMENT_MALWARE_SCAN_POLICY=DISABLED

# Test-only. Must identify a disposable database whose name contains test or ci.
# TEST_DATABASE_URL=postgresql://naim_pro_test:change-me@localhost:5432/naim_pro_test
